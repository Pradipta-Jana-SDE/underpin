# The pipeline runs fully without any of this. Rules resolve 75-85% of pages;
# the rest route to the human review queue. A model only shrinks that queue.

# none | ollama | groq | cerebras | gemini | openrouter
LLM_PROVIDER=none

# groq      -> qwen3-32b            (14,400 req/day free, no card)
# ollama    -> qwen2.5:7b-instruct  (no key, no signup, fully local)
# gemini    -> gemini-2.5-flash     (250 req/day free; trains on input)
LLM_MODEL=

# Omit entirely for provider=none or provider=ollama
LLM_API_KEY=

# Crawl politeness
UNDERPIN_CONCURRENCY=3
UNDERPIN_DELAY_MS=350
UNDERPIN_USER_AGENT=UnderpinBot/0.1 (+migration tooling; contact: you@example.com)
