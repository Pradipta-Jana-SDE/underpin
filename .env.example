# The model layer is OPTIONAL. With none of this set, the pipeline runs exactly as it does
# with it — the rules already name every component and decide every split. A model only
# ever improves a cosmetic call, and every failure path falls back to the rule.
#
# It is also off unless you ask for it: pass --llm on the CLI, or tick the box in the
# studio's build step. A demo has to be reproducible.

LLM_PROVIDER=none          # none | anthropic
LLM_MODEL=claude-opus-5    # any current Claude model id
LLM_API_KEY=               # or set ANTHROPIC_API_KEY
