{
  "name": "underpin",
  "private": true,
  "version": "0.1.0",
  "description": "Template-driven WordPress to React migration",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio": "node packages/studio/server.js",
    "migrate": "node packages/importer/bin/underpin.js run",
    "underpin": "node packages/importer/bin/underpin.js",
    "test": "node --test packages/importer/test/*.test.js",
    "build": "npm run build --workspaces --if-present",
    "reuse": "node packages/importer/bin/underpin.js reuse",
    "score": "node scripts/fidelity-score.mjs"
  },
  "dependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  }
}
