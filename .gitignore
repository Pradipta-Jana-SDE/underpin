node_modules/
dist/
*.tsbuildinfo
.env
.env.local
.cache/
# Generated sites nest one level deeper than the original rules assumed
# (sites/<host>/site/.next), so these must be recursive.
**/node_modules/
**/.next/
**/out/
# Mirrored copies of a source site's own CSS/JS/images. Generated artefacts of a demo
# run against sites we do not own — regenerate with `underpin build`, don't commit them.
sites/*/site/public/assets/
sites/*/site/public/media/
sites/*/site/content/pages/
.underpin/
.shots/
